{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/sync", "destination": "/api" },
    { "source": "/cases", "destination": "/api" },
    { "source": "/cases/:id*", "destination": "/api" },
    { "source": "/review", "destination": "/api" }
  ]
}
